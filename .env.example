# pyquotex web API — environment template.
#
# Usage:
#   cp .env.example .env       # then edit values below
#   docker compose up --build
#
# Only PYQUOTEX_EMAIL / PYQUOTEX_PASSWORD / PYQUOTEX_API_KEY are
# required; everything else has a sensible default.

# --- Required ----------------------------------------------------------------

PYQUOTEX_EMAIL=you@example.com
PYQUOTEX_PASSWORD=changeme
# Bearer token clients send via X-API-Key / Authorization: Bearer …
# Anyone with this key can place trades — generate a long random one.
PYQUOTEX_API_KEY=replace-me-with-a-long-random-string

# --- Account -----------------------------------------------------------------

# PRACTICE (demo) or REAL
PYQUOTEX_ACCOUNT_MODE=PRACTICE
PYQUOTEX_LANG=en

# --- Server ------------------------------------------------------------------

PYQUOTEX_PORT=8000
# Comma-separated list, or "*" for any origin.
PYQUOTEX_CORS_ORIGINS=*

# --- Tuning ------------------------------------------------------------------

PYQUOTEX_RESULT_POLL_TIMEOUT=90
PYQUOTEX_RELAY_POLL_INTERVAL=0.1

# --- Logging -----------------------------------------------------------------
#
# The container ships with WARNING-level logs by default — only
# broker errors, reconnect events, and broken-pipe warnings reach
# stdout. Override these two when you need more detail; reset to
# defaults when finished so production logs stay manageable.
#
# PYQUOTEX_LOG_LEVEL  — DEBUG | INFO | WARNING (default) | ERROR
# PYQUOTEX_ACCESS_LOG — 0 (default) | 1   (uvicorn per-request access log)

PYQUOTEX_LOG_LEVEL=WARNING
PYQUOTEX_ACCESS_LOG=0
