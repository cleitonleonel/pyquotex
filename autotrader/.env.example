# Autotrader — Telegram-driven autotrader on top of pyquotex.
#
# Usage:
#   cp .env.example .env       # then fill in the REQUIRED values below
#   docker compose up --build
#
# Phase 0 only needs the REQUIRED block; later phases will wire in the
# Telegram and broker credentials.

# ============================================================================
# REQUIRED — the app refuses to start without these
# ============================================================================

# Single-user dashboard passcode. Use a long, random string. Anyone with
# this passcode can place trades.
AUTOTRADER_PASSCODE=changeme-please-use-a-long-random-string

# Master encryption key (Fernet). Generate one with stdlib only:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Used to encrypt Quotex credentials and the Pyrogram session file at rest.
# Losing this key means losing the saved credentials — back it up.
AUTOTRADER_FERNET_KEY=

# ============================================================================
# REQUIRED FOR PHASE 2 (Telegram) — get from https://my.telegram.org/apps
# ============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ============================================================================
# SAFETY — keep LIVE_TRADING off until you've fully tested with DEMO
# ============================================================================

# Hard gate. Even when true, each channel still has its own enable flag.
AUTOTRADER_LIVE_TRADING_ENABLED=false

# ============================================================================
# TUNING — sensible defaults
# ============================================================================

AUTOTRADER_DB_URL=sqlite+aiosqlite:///./data/autotrader.db
AUTOTRADER_LOG_LEVEL=INFO
AUTOTRADER_API_HOST=0.0.0.0
AUTOTRADER_API_PORT=8000
AUTOTRADER_WEB_PORT=3000

# Comma-separated origins, or "*" for any.
AUTOTRADER_CORS_ORIGINS=http://localhost:3000

# Maximum OTP attempts per cycle. The admin-bot relay edits the same
# Telegram message up to this many times on bad codes; after the cap,
# it shows '/reconnect to retry'. Range: 1..10.
AUTOTRADER_OTP_MAX_ATTEMPTS=3

# ============================================================================
# OPS (Phase 7) — backups + error reporting
# ============================================================================

# SQLite online backups. ``0`` keeps the scheduler off (the default).
# Recommended for production: ``3600`` (hourly) with retain=24
# (one day rolling). Backups land in ``<db_dir>/backups/`` unless
# overridden.
AUTOTRADER_BACKUP_INTERVAL_SECONDS=0
AUTOTRADER_BACKUP_RETAIN=24
# AUTOTRADER_BACKUP_DIR=/data/backups

# Optional Sentry-style error reporting. Leave the DSN empty to disable.
AUTOTRADER_SENTRY_DSN=
AUTOTRADER_SENTRY_ENVIRONMENT=production
AUTOTRADER_SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================================================
# DEBUG — diagnostic flags, off in production
# ============================================================================

# Per-Telegram-update raw logging. Useful when channel posts fail to
# reach the live MessageHandler (peer-cache miss, missing channel
# subscription); a wave of UpdateChannelMessageViews with no
# UpdateNewChannelMessage tells you the channel update stream is
# alive but the post-delivery path is dropping.
AUTOTRADER_DEBUG_TELEGRAM_RAW_UPDATES=false

# Wrap each broker buy() / open_pending() in BrokerWireTrace, which
# taps pyquotex's send_websocket_request to record every outgoing
# socket.io frame around the call and emits structured
# ``executor.broker_wire.preflight`` + ``.postmortem`` logs.
# Diagnoses silent "Timeout waiting for realtime price data"
# failures where the broker UI shows the asset as tradable but no
# tick arrives in the 30 s pyquotex wait window. Off by default;
# the postmortem payload is large.
AUTOTRADER_DEBUG_BROKER_WIRE=false

# ============================================================================
# FRONTEND — baked into the Next.js build
# ============================================================================

NEXT_PUBLIC_API_BASE=http://localhost:8000
