# Autotrader — Telegram-driven autotrader on top of pyquotex.
#
# Usage:
#   cp .env.example .env       # then fill in the REQUIRED values below
#   docker compose up --build
#
# Phase 0 only needs the REQUIRED block; later phases will wire in the
# Telegram and broker credentials.

# ============================================================================
# REQUIRED — the app refuses to start without these
# ============================================================================

# Single-user dashboard passcode. Use a long, random string. Anyone with
# this passcode can place trades.
AUTOTRADER_PASSCODE=changeme-please-use-a-long-random-string

# Master encryption key (Fernet). Generate one with stdlib only:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Used to encrypt Quotex credentials and the Pyrogram session file at rest.
# Losing this key means losing the saved credentials — back it up.
AUTOTRADER_FERNET_KEY=

# ============================================================================
# REQUIRED FOR PHASE 2 (Telegram) — get from https://my.telegram.org/apps
# ============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ============================================================================
# SAFETY — keep LIVE_TRADING off until you've fully tested with DEMO
# ============================================================================

# Hard gate. Even when true, each channel still has its own enable flag.
AUTOTRADER_LIVE_TRADING_ENABLED=false

# ============================================================================
# TUNING — sensible defaults
# ============================================================================

AUTOTRADER_DB_URL=sqlite+aiosqlite:///./data/autotrader.db
AUTOTRADER_LOG_LEVEL=INFO
AUTOTRADER_API_HOST=0.0.0.0
AUTOTRADER_API_PORT=8000
AUTOTRADER_WEB_PORT=3000

# Comma-separated origins, or "*" for any.
AUTOTRADER_CORS_ORIGINS=http://localhost:3000

# ============================================================================
# FRONTEND — baked into the Next.js build
# ============================================================================

NEXT_PUBLIC_API_BASE=http://localhost:8000
