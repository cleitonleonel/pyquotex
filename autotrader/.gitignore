# Autotrader-specific ignores (root .gitignore covers .env, .venv, node_modules, *.db)

# Build artefacts
.next/
out/
dist/
build/

# Runtime data
data/
*.session
*.session-journal

# Lockfiles — KEEP these committed for reproducible builds
# (uv.lock and bun.lock are the source of truth)
!uv.lock
!bun.lock
!bun.lockb
